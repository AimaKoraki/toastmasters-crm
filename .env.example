# Supabase Cloud Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Authentication & Security Passkeys
EXCO_PASSKEY=your-secure-exco-passkey
SESSION_SECRET=a-secure-random-32-character-string-for-session-encryption

# Optional Server Port (Defaults to 8000 locally, dynamically assigned on cloud)
PORT=8000
